{
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$PROJECT_DIR\" run build"]
  },
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {"source": "**", "function": {"functionId": "privateStudio", "region": "us-central1"}}
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
